# Оставьте адрес пустым для mock-режима с детерминированными ответами.
# Для live-режима укажите адрес Ollama или OpenAI-совместимого сервера и имя модели.
LLM_BASE_URL=
LLM_MODEL=
# Ключ нужен только тем серверам, которые требуют Bearer-аутентификацию.
LLM_API_KEY=

# HTTP-адрес сервера. Запускайте приложение из корня репозитория.
ADDR=:8080
